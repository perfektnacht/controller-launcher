  "prismlauncher": {
    "icon": "org.prismlauncher.PrismLauncher",
    "glyph": "󰆧",
    "accent": "#5d62a4",
    "label": "Prism",
    "sublabel": "Minecraft",
    "when": "false",
    "installed": "command -v prismlauncher >/dev/null 2>&1 || flatpak info org.prismlauncher.PrismLauncher >/dev/null 2>&1",
    "action": "if command -v prismlauncher >/dev/null 2>&1; then exec prismlauncher; else exec flatpak run org.prismlauncher.PrismLauncher; fi",
    "install": ""
  },
  "moonlight": {
    "icon": "moonlight",
    "glyph": "",
    "accent": "#35b8b0",
    "label": "Moonlight",
    "sublabel": "Streaming",
    "when": "false",
    "mediaThemed": true,
    "installed": "command -v moonlight >/dev/null 2>&1 || flatpak info com.moonlight_stream.Moonlight >/dev/null 2>&1",
    "action": "if command -v moonlight >/dev/null 2>&1; then exec moonlight; else exec flatpak run com.moonlight_stream.Moonlight; fi",
    "install": ""
  },
  "geforce-now": {
    "icon": "com.nvidia.geforcenow",
    "glyph": "\udb82\udcb9",
    "accent": "#76b900",
    "label": "GeForce NOW",
    "sublabel": "Streaming",
    "installed": "flatpak info com.nvidia.geforcenow",
    "action": "(for i in $(seq 1 50); do hyprctl clients -j 2>/dev/null | jq -e 'any(.[]; .class==\"GeForceNOW\")' >/dev/null 2>&1 && hyprctl dispatch 'hl.dsp.window.fullscreen({mode=\"fullscreen\", window=\"class:^(GeForceNOW)$\"})' >/dev/null 2>&1 && break; sleep 0.2; done &) ; exec flatpak run com.nvidia.geforcenow",
    "install": "omarchy-launch-floating-terminal-with-presentation omarchy-install-gaming-geforce-now"
  },
  "xbox-cloud": {
    "icon": "xbox",
    "glyph": "",
    "accent": "#107c10",
    "label": "Xbox Cloud",
    "sublabel": "Streaming",
    "installed": "[[ -f \"$HOME/.local/share/applications/Xbox Cloud Gaming.desktop\" ]]",
    "action": "omarchy-launch-webapp https://www.xbox.com/en-US/play",
    "install": "omarchy-launch-floating-terminal-with-presentation omarchy-install-gaming-xbox-cloud"
  },
