#!/usr/bin/env python3
"""Watch a gamepad and report wheel gestures as JSON lines on stdout.

Deliberately dumb: it reports button edges and a normalized stick vector and
lets the QML side decide what a sector is. Nothing about launchers, geometry,
or Hyprland lives here.

Two states, and the difference is the whole point of the arm/disarm toggle:

  disarmed (default)  passive read only. Every other app on the system sees
                      the controller exactly as it did before. There is
                      nothing to undo because nothing was changed.
  armed               adds EVIOCGRAB, so the summon button does not leak into
                      whatever has focus. The kernel drops the grab when this
                      process's fd closes -- including on SIGKILL -- so a crash
                      cannot leave the controller captured.

Nothing here writes to disk, loads a module, or touches device firmware state.
stdlib only, so there is no install step.

Protocol
  stdout  one JSON object per line (see emit() calls below)
  stdin   "arm" | "disarm" | "status" | "quit", one per line
"""

import array
import fcntl
import glob
import json
import os
import select
import signal
import struct
import sys
import time

EV_SYN, EV_KEY, EV_ABS = 0x00, 0x01, 0x03
ABS_X, ABS_Y = 0x00, 0x01

BUTTONS = {
    "south": 0x130,   # Cross / A
    "east": 0x131,    # Circle / B
    "north": 0x133,   # Triangle / Y
    "west": 0x134,    # Square / X
    "select": 0x13A,  # Create / Back
    "start": 0x13B,   # Options / Start
    "mode": 0x13C,    # PS / Guide / Steam
}

# struct input_event { struct timeval time; __u16 type, code; __s32 value; }
EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)

# The 2026 Steam Controller puck. hid-steam claims 1102, 1142 and 1205 only,
# so all five of its interfaces fall to hid-generic and the kernel publishes
# nothing but the firmware's own mouse/keyboard emulation -- lizard mode.
#
# The full controller state is there anyway: the vendor collection streams a
# 53-byte input report 0x42 at ~270Hz whether or not anything has taken the
# controller out of lizard mode. Reading it needs no driver, no udev rule
# (logind's ACL already grants the seat owner access to hidraw), and above all
# no writes -- so nothing about the controller's state outlives this process.
STEAM_VENDOR, STEAM_PUCK = 0x28DE, 0x1304
STEAM_REPORT_ID, STEAM_REPORT_LEN = 0x42, 54

# Offsets and masks within report 0x42, mapped by holding each button in turn
# and diffing against an idle capture.
STEAM_BUTTONS = {
    "south": (2, 0x01),
    "east": (2, 0x02),
    "west": (2, 0x04),
    "north": (2, 0x08),
    "start": (2, 0x40),
    "select": (3, 0x40),
    "mode": (4, 0x01),
}
STEAM_STICK_X, STEAM_STICK_Y = 10, 12  # int16 LE each, full scale +-32767

_IOC_WRITE, _IOC_READ = 1, 2


def _ioc(direction, letter, nr, size):
    return (direction << 30) | (size << 16) | (ord(letter) << 8) | nr


EVIOCGRAB = _ioc(_IOC_WRITE, "E", 0x90, 4)


def _EVIOCGNAME(length):
    return _ioc(_IOC_READ, "E", 0x06, length)


def _EVIOCGBIT(ev, length):
    return _ioc(_IOC_READ, "E", 0x20 + ev, length)


def _EVIOCGABS(axis):
    return _ioc(_IOC_READ, "E", 0x40 + axis, 24)  # struct input_absinfo


# struct hidraw_devinfo { __u32 bustype; __s16 vendor; __s16 product; }
HIDIOCGRAWINFO = _ioc(_IOC_READ, "H", 0x03, 8)


def _HIDIOCGRAWNAME(length):
    return _ioc(_IOC_READ, "H", 0x04, length)


def normalize_axis(bounds, raw):
    """Map a raw axis reading to -1.0..1.0 with the device's deadzone."""
    minimum, maximum, flat = bounds
    span = (maximum - minimum) / 2.0
    if span <= 0:
        return 0.0
    centered = raw - (minimum + span)
    deadzone = max(flat, span * 0.12)
    if abs(centered) <= deadzone:
        return 0.0
    # Rescale so motion starts at 0 just outside the deadzone rather than
    # jumping to whatever fraction the deadzone happened to cut off.
    scaled = (abs(centered) - deadzone) / (span - deadzone)
    return max(-1.0, min(1.0, scaled if centered > 0 else -scaled))


def emit(**payload):
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()


def _bit_set(buf, bit):
    return bool(buf[bit >> 3] & (1 << (bit & 7)))


class Gamepad:
    """One evdev node that looks like a gamepad."""

    def __init__(self, path, fd, name, axes):
        self.path = path
        self.fd = fd
        self.name = name
        self.axes = axes  # {code: (minimum, maximum, flat)}
        self.grabbed = False

    @classmethod
    def probe(cls, path):
        """Open path and return a Gamepad if it has sticks and face buttons."""
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            return None
        try:
            name_buf = array.array("B", bytes(256))
            fcntl.ioctl(fd, _EVIOCGNAME(256), name_buf, True)
            name = bytes(name_buf).split(b"\x00", 1)[0].decode("utf-8", "replace")

            keys = array.array("B", bytes(96))  # covers codes up to 0x2FF
            fcntl.ioctl(fd, _EVIOCGBIT(EV_KEY, len(keys)), keys, True)
            absolute = array.array("B", bytes(8))
            fcntl.ioctl(fd, _EVIOCGBIT(EV_ABS, len(absolute)), absolute, True)

            # A gamepad has a south face button and a left stick. The
            # DualSense's motion-sensor and touchpad nodes share its name and
            # vendor id but fail this, which is exactly what we want.
            if not _bit_set(keys, BUTTONS["south"]):
                return None
            if not (_bit_set(absolute, ABS_X) and _bit_set(absolute, ABS_Y)):
                return None

            axes = {}
            for axis in (ABS_X, ABS_Y):
                info = array.array("B", bytes(24))
                fcntl.ioctl(fd, _EVIOCGABS(axis), info, True)
                _value, minimum, maximum, _fuzz, flat, _res = struct.unpack("6i", info)
                axes[axis] = (minimum, maximum, flat)
            return cls(path, fd, name, axes)
        except OSError:
            os.close(fd)
            return None

    def normalize(self, axis, raw):
        return normalize_axis(self.axes[axis], raw)

    def read_events(self):
        """Decoded (type, code, value) tuples, or None once the node is gone."""
        try:
            data = os.read(self.fd, EVENT_SIZE * 64)
        except BlockingIOError:
            return []
        except OSError:
            return None
        if not data:
            return None
        events = []
        for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
            _sec, _usec, etype, code, value = struct.unpack_from(
                EVENT_FMT, data, offset
            )
            if etype != EV_SYN:
                events.append((etype, code, value))
        return events

    def set_grab(self, wanted):
        if wanted == self.grabbed:
            return True
        try:
            fcntl.ioctl(self.fd, EVIOCGRAB, 1 if wanted else 0)
        except OSError as err:
            emit(t="error", msg="grab failed: %s" % err)
            return False
        self.grabbed = wanted
        return True

    def close(self):
        # Closing the fd is what actually releases the grab; the explicit
        # ungrab is only so a still-open duplicate fd would not keep it.
        try:
            if self.grabbed:
                fcntl.ioctl(self.fd, EVIOCGRAB, 0)
        except OSError:
            pass
        finally:
            self.grabbed = False
            try:
                os.close(self.fd)
            except OSError:
                pass


class SteamPuck:
    """The Steam Controller puck, read straight off its vendor hidraw node.

    Presents the same surface as Gamepad, so the daemon above does not know or
    care which one it is holding.
    """

    # Full scale on both axes. Bounds rather than the driver's absinfo, which
    # hidraw does not have; the flat term is the deadzone the pad reports at
    # rest, measured at roughly +-500 of 32767.
    AXES = {ABS_X: (-32767, 32767, 600), ABS_Y: (-32767, 32767, 600)}

    def __init__(self, path, fd, name):
        self.path = path
        self.fd = fd
        self.name = name
        self.axes = self.AXES
        self.grabbed = False
        self.pressed = {}
        self.stick = [None, None]
        self.lizard_fds = []

    @classmethod
    def probe(cls, path):
        """Open a hidraw node and return a SteamPuck if it is a puck."""
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            return None
        try:
            info = array.array("B", bytes(8))
            fcntl.ioctl(fd, HIDIOCGRAWINFO, info, True)
            _bus, vendor, product = struct.unpack("Ihh", bytes(info))
            if (vendor & 0xFFFF, product & 0xFFFF) != (STEAM_VENDOR, STEAM_PUCK):
                os.close(fd)
                return None

            name_buf = array.array("B", bytes(256))
            try:
                fcntl.ioctl(fd, _HIDIOCGRAWNAME(256), name_buf, True)
                name = bytes(name_buf).split(b"\x00", 1)[0].decode("utf-8", "replace")
            except OSError:
                name = "Steam Controller"
            return cls(path, fd, name)
        except OSError:
            os.close(fd)
            return None

    @classmethod
    def discover(cls):
        """The puck interface a controller is actually talking on.

        All five interfaces advertise report 0x42, but only the slot holding a
        connected controller streams it. Rather than guess, open every puck
        node and keep whichever one delivers first -- at ~270Hz a connected
        controller answers well inside this window, and an empty slot stays
        silent forever.
        """
        candidates = []
        for path in sorted(glob.glob("/dev/hidraw*")):
            puck = cls.probe(path)
            if puck:
                candidates.append(puck)
        if not candidates:
            return None

        chosen = None
        by_fd = {puck.fd: puck for puck in candidates}
        try:
            ready, _, _ = select.select(list(by_fd), [], [], 0.15)
        except OSError:
            ready = []
        for fd in ready:
            try:
                data = os.read(fd, 128)
            except OSError:
                continue
            if data and data[0] == STEAM_REPORT_ID:
                chosen = by_fd[fd]
                break

        for puck in candidates:
            if puck is not chosen:
                puck.close()
        return chosen

    def normalize(self, axis, raw):
        return normalize_axis(self.axes[axis], raw)

    def read_events(self):
        events = []
        while True:
            try:
                report = os.read(self.fd, 128)
            except BlockingIOError:
                break
            except OSError:
                return None
            if not report:
                return None
            if len(report) >= STEAM_REPORT_LEN and report[0] == STEAM_REPORT_ID:
                events.extend(self._decode(report))
        return events

    def _decode(self, report):
        """One 0x42 report as evdev-shaped events, emitting only changes."""
        events = []
        for name, (offset, mask) in STEAM_BUTTONS.items():
            held = bool(report[offset] & mask)
            if held != self.pressed.get(name):
                self.pressed[name] = held
                events.append((EV_KEY, BUTTONS[name], 1 if held else 0))

        x = struct.unpack_from("<h", report, STEAM_STICK_X)[0]
        # The report has +y up. evdev has +y down and everything above this
        # reads these as evdev, so flip here rather than special-casing there.
        y = -struct.unpack_from("<h", report, STEAM_STICK_Y)[0]
        for index, (axis, value) in enumerate(((ABS_X, x), (ABS_Y, y))):
            if self.stick[index] != value:
                self.stick[index] = value
                events.append((EV_ABS, axis, value))
        return events

    def _lizard_nodes(self):
        """The evdev nodes the puck's firmware emulation feeds.

        Same hid interface as the report we read, so these are exactly the
        mouse and keyboard that would otherwise fling the pointer around and
        type into whatever has focus while the wheel is up.
        """
        base = "/sys/class/hidraw/%s/device/input" % os.path.basename(self.path)
        return [
            "/dev/input/%s" % os.path.basename(node)
            for node in sorted(glob.glob(os.path.join(base, "input*", "event*")))
        ]

    def set_grab(self, wanted):
        if wanted == self.grabbed:
            return True
        if not wanted:
            self._release()
            self.grabbed = False
            return True

        # There is no EVIOCGRAB for hidraw, and the state we read is not what
        # leaks -- lizard mode is. Grabbing those nodes is the equivalent, and
        # it stays a property of our open fds: the kernel drops them on exit.
        ok = True
        for node in self._lizard_nodes():
            try:
                fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
            except OSError as err:
                emit(t="error", msg="grab failed: %s" % err)
                ok = False
                continue
            try:
                fcntl.ioctl(fd, EVIOCGRAB, 1)
                self.lizard_fds.append(fd)
            except OSError as err:
                emit(t="error", msg="grab failed: %s" % err)
                os.close(fd)
                ok = False
        self.grabbed = bool(self.lizard_fds)
        return ok

    def _release(self):
        while self.lizard_fds:
            fd = self.lizard_fds.pop()
            try:
                fcntl.ioctl(fd, EVIOCGRAB, 0)
            except OSError:
                pass
            try:
                os.close(fd)
            except OSError:
                pass

    def close(self):
        self._release()
        self.grabbed = False
        try:
            os.close(self.fd)
        except OSError:
            pass


def find_gamepad(preferred=None):
    """The device to drive the wheel: a real gamepad, else the Steam puck."""
    if preferred:
        return Gamepad.probe(preferred) or SteamPuck.probe(preferred)
    for path in sorted(glob.glob("/dev/input/event*")):
        pad = Gamepad.probe(path)
        if pad:
            return pad
    # Only once no proper gamepad answered: a DualSense presents as one and is
    # the better device when both are on the desk.
    return SteamPuck.discover()


class Daemon:
    AIM_INTERVAL = 1.0 / 60.0

    def __init__(self, summon_button, cancel_button, device=None):
        self.device = device
        self.summon_code = BUTTONS[summon_button]
        self.cancel_code = BUTTONS[cancel_button]
        self.summon_name = summon_button
        self.pad = None
        self.armed = False
        self.running = True

        self.open = False       # wheel currently summoned
        self.cancelled = False  # cancel pressed during this summon
        self.aim = [0.0, 0.0]
        self.aim_sent = 0.0
        self.aim_dirty = False

    # ---------------------------------------------------------------- device

    def attach(self):
        pad = find_gamepad(self.device)
        if not pad:
            return False
        self.pad = pad
        if self.armed:
            pad.set_grab(True)
        emit(t="device", connected=True, name=pad.name, path=pad.path)
        return True

    def detach(self):
        if not self.pad:
            return
        name = self.pad.name
        self.pad.close()
        self.pad = None
        if self.open:
            self.close_wheel(commit=False)
        emit(t="device", connected=False, name=name)

    # ----------------------------------------------------------------- wheel

    def open_wheel(self):
        self.open = True
        self.cancelled = False
        self.aim = [0.0, 0.0]
        emit(t="summon")
        emit(t="aim", x=0.0, y=0.0)

    def close_wheel(self, commit):
        self.open = False
        if commit and not self.cancelled:
            emit(t="commit", x=self.aim[0], y=self.aim[1])
        else:
            emit(t="cancel")
        self.cancelled = False

    def flush_aim(self, now):
        if not self.aim_dirty or now - self.aim_sent < self.AIM_INTERVAL:
            return
        self.aim_dirty = False
        self.aim_sent = now
        emit(t="aim", x=self.aim[0], y=self.aim[1])

    # ---------------------------------------------------------------- events

    def handle_event(self, etype, code, value):
        if etype == EV_KEY:
            if code == self.summon_code:
                if value == 1 and not self.open:
                    self.open_wheel()
                elif value == 0 and self.open:
                    self.close_wheel(commit=True)
            elif code == self.cancel_code and value == 1 and self.open:
                self.cancelled = True
                emit(t="aborting")
        elif etype == EV_ABS and self.open:
            if code == ABS_X:
                self.aim[0] = self.pad.normalize(ABS_X, value)
                self.aim_dirty = True
            elif code == ABS_Y:
                # evdev Y grows downward; the wheel thinks in screen space too,
                # so this is passed through rather than flipped.
                self.aim[1] = self.pad.normalize(ABS_Y, value)
                self.aim_dirty = True

    def pump_device(self):
        events = self.pad.read_events()
        if events is None:  # node went away
            self.detach()
            return
        for etype, code, value in events:
            self.handle_event(etype, code, value)

    # --------------------------------------------------------------- control

    def set_armed(self, wanted):
        self.armed = wanted
        if self.pad:
            self.pad.set_grab(wanted)
        self.report_status()

    def report_status(self):
        emit(
            t="status",
            armed=self.armed,
            grabbed=bool(self.pad and self.pad.grabbed),
            connected=bool(self.pad),
            name=self.pad.name if self.pad else "",
            summon=self.summon_name,
        )

    def handle_command(self, line):
        command = line.strip().lower()
        if command == "arm":
            self.set_armed(True)
        elif command == "disarm":
            self.set_armed(False)
        elif command == "status":
            self.report_status()
        elif command == "quit":
            self.running = False

    # ------------------------------------------------------------------ loop

    def run(self):
        self.attach()
        self.report_status()
        stdin_fd = sys.stdin.fileno()
        next_scan = 0.0

        while self.running:
            now = time.monotonic()
            if not self.pad and now >= next_scan:
                next_scan = now + 1.0
                self.attach()

            fds = [stdin_fd] + ([self.pad.fd] if self.pad else [])
            timeout = self.AIM_INTERVAL if self.aim_dirty else 1.0
            try:
                ready, _, _ = select.select(fds, [], [], timeout)
            except InterruptedError:
                continue

            if stdin_fd in ready:
                line = sys.stdin.readline()
                if not line:  # shell closed the pipe
                    break
                self.handle_command(line)
            if self.pad and self.pad.fd in ready:
                self.pump_device()

            self.flush_aim(time.monotonic())

        self.shutdown()

    def shutdown(self):
        if self.pad:
            self.pad.close()
            self.pad = None


def main():
    args = sys.argv[1:]
    if "--list-devices" in args:
        for path in sorted(glob.glob("/dev/input/event*")):
            pad = Gamepad.probe(path)
            if pad:
                print("%s  %s" % (path, pad.name))
                pad.close()
        # Listed separately: every puck interface advertises the report, so
        # say which one a controller is actually live on rather than all five.
        puck = SteamPuck.discover()
        if puck:
            print("%s  %s (streaming)" % (puck.path, puck.name))
            puck.close()
        return 0

    summon = "mode"
    cancel = "east"
    device = None
    for index, arg in enumerate(args):
        if arg == "--summon" and index + 1 < len(args):
            summon = args[index + 1]
        elif arg == "--cancel" and index + 1 < len(args):
            cancel = args[index + 1]
        elif arg == "--device" and index + 1 < len(args):
            device = args[index + 1]
    if summon not in BUTTONS or cancel not in BUTTONS:
        sys.stderr.write("unknown button; known: %s\n" % ", ".join(sorted(BUTTONS)))
        return 2

    daemon = Daemon(summon, cancel, device)

    def stop(_signum, _frame):
        daemon.running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        daemon.run()
    finally:
        daemon.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
